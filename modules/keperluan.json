      "DIHANTAR",
      "DIKEMBALIKAN"
    ]
  },
  "statuses": [
    {
      "value": "DIHANTAR",
      "label": "Dihantar",
      "tone": "info"
    },
    {
      "value": "DIKEMBALIKAN",
      "label": "Dikembalikan untuk pembetulan",
      "tone": "warn"
    },
    {
      "value": "DISAHKAN",
      "label": "Disahkan Unit IT",
      "tone": "success"
    },
    {
      "value": "DITOLAK",
      "label": "Ditolak",
      "tone": "danger"
    }
  ],
  "notify": {
    "adminsOnCreate": true,
